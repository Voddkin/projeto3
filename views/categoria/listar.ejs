<script src="/js/categoria/excluir.js"></script>

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Categorias</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
    <div class="container">

        <a class="navbar-brand fw-bold" href="/produto">
            <i class="fas fa-store"></i> Nativus
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/produto">
                        <i class="fas fa-box"></i> Produtos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/categoria">
                        <i class="fas fa-layer-group"></i> Categorias
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/marca">
                        <i class="fas fa-tag"></i> Marcas
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/pessoa">
                        <i class="fas fa-user"></i> Pessoas
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>

<body>

    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Lista de Categorias</h2>

            <a href="/cadastrarcategoria" class="btn btn-primary">
                Cadastrar Categoria
            </a>

        </div>

        <div class="card shadow">

            <div class="card-body">

                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% for(let i = 0; i < lista.length; i++) { %>

                            <tr>

                                <td>
                                    <%= lista[i].id %>
                                </td>

                                <td>
                                    <%= lista[i].nome %>
                                </td>

                                <td>
                                    <%= lista[i].descricao %>
                                </td>

                                <td>

                                    <a href="/alterarcategoria/<%= lista[i].id %>" class="btn btn-primary">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <button
                                        type="button"
                                        data-idexclusao="<%= lista[i].id %>"
                                        class="btnExclusao btn btn-danger">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>