<script src="/js/categoria/alterar.js"></script>

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alteração de Categoria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <div class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card shadow">

                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Alteração de Categoria</h4>
                    </div>

                    <div class="card-body">

                        <div>
                            <input id="inputId" type="hidden" value="<%= catAlteracao.id %>">

                            <div class="mb-3">
                                <label class="form-label">Nome:</label>
                                <input value="<%= catAlteracao.nome %>"
                                       class="form-control"
                                       type="text"
                                       id="inputNome" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descrição:</label>
                                <input value="<%= catAlteracao.descricao %>"
                                       class="form-control"
                                       type="text"
                                       id="inputDescricao" />
                            </div>

                            <div class="d-flex justify-content-between">

                                <a class="btn btn-secondary" href="/categoria">
                                    Voltar
                                </a>

                                <button id="btnGravar" class="btn btn-primary">
                                    <i class="fas fa-check"></i> Alterar
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>